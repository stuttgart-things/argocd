{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "schmetterpause-database sub-chart",
  "type": "object",
  "additionalProperties": false,
  "required": ["namespace", "name", "instances", "imageName", "storage", "bootstrap"],
  "properties": {
    "namespace":  { "type": "string", "minLength": 1 },
    "name":       { "type": "string", "minLength": 1 },
    "instances":  { "type": "integer", "minimum": 1 },
    "imageName":  { "type": "string", "minLength": 1 },
    "enableSuperuserAccess": { "type": "boolean" },
    "protect": { "type": "boolean", "description": "Annotate the Cluster with Prune=false,Delete=false. The PVC is owned by the Cluster, so deleting it destroys the data." },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size"],
      "properties": {
        "size":         { "type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$" },
        "storageClass": { "type": "string", "description": "Leave empty only on a cluster with exactly one default StorageClass." }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database", "owner", "secretName"],
      "properties": {
        "database":      { "type": "string", "minLength": 1 },
        "owner":         { "type": "string", "minLength": 1 },
        "secretName":    { "type": "string", "minLength": 1 },
        "encoding":      { "type": "string" },
        "localeCollate": { "type": "string" },
        "localeCType":   { "type": "string" }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": true,
      "description": "Inert pass-through. Present so verify-catalog's probe values do not fail strict additionalProperties:false validation; the chart itself does not consume this field."
    }
  }
}

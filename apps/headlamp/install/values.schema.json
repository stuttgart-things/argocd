{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "headlamp app-of-apps chart",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "destination", "chartVersion"],
  "properties": {
    "applicationName": {
      "type": "string",
      "minLength": 1,
      "description": "Optional explicit name for the rendered ArgoCD Application. Defaults to a per-cluster derived name to avoid collisions when deployed to multiple clusters."
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "description": "Reference to this catalog repo, used by the optional rbac Application.",
      "properties": {
        "repoURL": { "type": "string", "format": "uri" },
        "targetRevision": { "type": "string", "minLength": 1 }
      },
      "required": ["repoURL", "targetRevision"]
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "description": "ArgoCD AppProject for the rendered Applications."
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "server": { "type": "string", "format": "uri" },
        "namespace": { "type": "string", "minLength": 1 }
      },
      "required": ["server", "namespace"]
    },
    "chartVersion": {
      "type": "string",
      "minLength": 1,
      "description": "Upstream Headlamp chart version."
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "hostname": { "type": "string", "minLength": 1 },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "namespace": { "type": "string", "minLength": 1 }
          },
          "required": ["name", "namespace"]
        }
      },
      "required": ["enabled"],
      "if": { "properties": { "enabled": { "const": true } } },
      "then": { "required": ["hostname", "gateway"] }
    },
    "plugins": {
      "type": "array",
      "description": "Plugins loaded by Headlamp's pluginsManager. Empty disables pluginsManager.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "format": "uri" }
        },
        "required": ["name", "source"]
      }
    },
    "extraValues": {
      "type": "object",
      "description": "Deep-merged on top of the computed valuesObject passed to the upstream chart.",
      "additionalProperties": true
    },
    "oidc": {
      "type": "object",
      "additionalProperties": false,
      "description": "OIDC login instead of the ServiceAccount token. Empty issuer = off.",
      "properties": {
        "issuer": { "type": "string", "pattern": "^(https://[^\\s]*[^/\\s])?$", "description": "OIDC issuer URL without trailing slash. Empty = OIDC login off." },
        "clientId": { "type": "string", "description": "OIDC client ID; also the kube-apiserver audience." },
        "scopes": { "type": "string", "minLength": 1, "description": "Comma-separated scopes; openid is added by Headlamp." },
        "callbackUrl": { "type": "string", "pattern": "^(https?://.+)?$", "description": "Empty = https://<httpRoute.hostname>/oidc-callback." },
        "clientSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "key": { "type": "string", "minLength": 1 }
          },
          "required": ["name", "key"]
        },
        "caConfigMap": { "type": "string", "description": "CA bundle ConfigMap for the issuer. Empty = system roots." },
        "caKey": { "type": "string" }
      },
      "if": { "properties": { "issuer": { "minLength": 1 } }, "required": ["issuer"] },
      "then": {
        "required": ["clientId", "scopes", "clientSecret"],
        "properties": { "clientId": { "minLength": 1 } }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" }
      },
      "required": ["enabled"]
    },
    "syncPolicy": {
      "type": "object",
      "description": "ArgoCD sync policy applied to both rendered Applications.",
      "additionalProperties": true
    }
  }
}

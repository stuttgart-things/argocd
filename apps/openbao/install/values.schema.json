{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "openbao app-of-apps chart",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "applicationName": {
      "type": "string",
      "minLength": 1,
      "description": "Optional explicit name for the rendered ArgoCD Application. Defaults to a per-cluster derived name (sha1 of destination.server) to avoid collisions when deployed to multiple clusters."
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repoURL": {
          "type": "string",
          "format": "uri"
        },
        "targetRevision": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "repoURL",
        "targetRevision"
      ]
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "server": {
          "type": "string",
          "format": "uri"
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "server",
        "namespace"
      ]
    },
    "chartVersion": {
      "type": "string",
      "minLength": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "repository"
      ],
      "description": "No tag on purpose: the chart derives it from its appVersion with the leading v stripped."
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {
          "type": "string",
          "minLength": 1
        },
        "storageClass": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "size",
        "storageClass"
      ]
    },
    "topology": {
      "type": "string",
      "enum": [
        "single-node",
        "multi-node"
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "string",
              "minLength": 1
            },
            "memory": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "string",
              "minLength": 1
            },
            "memory": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "singleNode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "injectorEnabled": {
          "type": "boolean"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "seal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "none",
            "static",
            "transit"
          ]
        },
        "static": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "keyId": {
              "type": "string"
            },
            "secretName": {
              "type": "string",
              "minLength": 1
            },
            "secretKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "secretName",
            "secretKey"
          ]
        },
        "transit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "address": {
              "type": "string"
            },
            "keyName": {
              "type": "string",
              "minLength": 1
            },
            "mountPath": {
              "type": "string",
              "minLength": 1
            },
            "secretName": {
              "type": "string",
              "minLength": 1
            },
            "secretKey": {
              "type": "string",
              "minLength": 1
            },
            "trustBundle": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "configMap": {
                  "type": "string",
                  "minLength": 1
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "configMap",
                "key"
              ]
            }
          },
          "required": [
            "keyName",
            "mountPath",
            "secretName",
            "secretKey",
            "trustBundle"
          ]
        },
        "externalSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "store": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "ClusterSecretStore",
                    "SecretStore"
                  ]
                }
              },
              "required": [
                "name",
                "kind"
              ]
            },
            "remoteKey": {
              "type": "string",
              "minLength": 1
            },
            "refreshInterval": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "enabled"
          ],
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "store",
              "remoteKey",
              "refreshInterval"
            ]
          }
        }
      },
      "required": [
        "type"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "static"
              }
            }
          },
          "then": {
            "required": [
              "static"
            ],
            "properties": {
              "static": {
                "required": [
                  "keyId"
                ],
                "properties": {
                  "keyId": {
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "transit"
              }
            }
          },
          "then": {
            "required": [
              "transit"
            ],
            "properties": {
              "transit": {
                "required": [
                  "address"
                ],
                "properties": {
                  "address": {
                    "minLength": 1,
                    "pattern": "^https?://"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "init": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "none",
            "self-init-userpass"
          ]
        }
      },
      "required": [
        "mode"
      ]
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "namespace": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "namespace"
          ]
        }
      },
      "required": [
        "enabled"
      ],
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "hostname",
          "gateway"
        ]
      }
    },
    "extraValues": {
      "type": "object",
      "additionalProperties": true,
      "description": "Deep-merged on top of the computed valuesObject passed to the upstream openbao chart."
    },
    "syncPolicy": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "project",
    "destination",
    "chartVersion",
    "image",
    "storage",
    "topology",
    "seal",
    "init"
  ],
  "allOf": [
    {
      "description": "self-init-userpass needs an auto-unseal: OpenBao refuses self-init with shamir.",
      "if": {
        "required": [
          "init"
        ],
        "properties": {
          "init": {
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "const": "self-init-userpass"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "seal": {
            "properties": {
              "type": {
                "enum": [
                  "static",
                  "transit"
                ]
              }
            }
          }
        }
      }
    }
  ]
}

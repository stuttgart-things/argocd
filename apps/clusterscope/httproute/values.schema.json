{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "clusterscope httproute sub-chart",
  "type": "object",
  "additionalProperties": false,
  "required": ["namespace", "hostname", "gateway"],
  "properties": {
    "destination": {
      "type": "object",
      "additionalProperties": true,
      "description": "Inert pass-through. Present so verify-catalog's probe values do not fail strict additionalProperties:false validation; the chart itself does not consume this field."
    },
    "namespace": { "type": "string", "minLength": 1 },
    "hostname": { "type": "string", "minLength": 1 },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "namespace"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string", "minLength": 1 },
        "sectionName": { "type": "string" }
      }
    }
  }
}

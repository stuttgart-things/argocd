{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "clusterscope config sub-chart",
  "type": "object",
  "additionalProperties": false,
  "required": ["namespace", "refreshInterval", "config", "gitAuth", "kubeconfigs"],
  "properties": {
    "destination": {
      "type": "object",
      "additionalProperties": true,
      "description": "Inert pass-through. Present so verify-catalog's probe values do not fail strict additionalProperties:false validation; the chart itself does not consume this field."
    },
    "namespace": { "type": "string", "minLength": 1 },
    "refreshInterval": { "type": "string", "minLength": 1 },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "content": { "type": "string", "description": "The -config file (YAML or one line of JSON)." }
      },
      "if": { "properties": { "enabled": { "const": true } } },
      "then": { "required": ["content"], "properties": { "content": { "minLength": 1 } } }
    },
    "gitAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "secretName"],
      "properties": {
        "enabled": { "type": "boolean" },
        "secretName": { "type": "string", "minLength": 1 },
        "secretStore": { "$ref": "#/definitions/secretStore" },
        "path": { "type": "string" },
        "usernameProperty": { "type": "string", "minLength": 1 },
        "passwordProperty": { "type": "string", "minLength": 1 }
      },
      "if": { "properties": { "enabled": { "const": true } } },
      "then": {
        "required": ["secretStore", "path"],
        "properties": {
          "path": { "minLength": 1 },
          "secretStore": { "properties": { "name": { "minLength": 1 } } }
        }
      }
    },
    "kubeconfigs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "secretStore": { "$ref": "#/definitions/secretStore" },
        "clusters": { "type": "string", "minLength": 1, "description": "Regexp over the Vault entry names." }
      }
    }
  },
  "definitions": {
    "secretStore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": { "type": "string", "enum": ["ClusterSecretStore", "SecretStore"] },
        "name": { "type": "string" }
      }
    }
  }
}

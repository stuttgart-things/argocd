{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "backstage-config sub-chart",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "namespace",
    "configMapName"
  ],
  "properties": {
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "configMapName": {
      "type": "string",
      "minLength": 1
    },
    "oidc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "clientId": { "type": "string", "pattern": "^[0-9]*$" },
        "projectId": { "type": "string", "pattern": "^[0-9]*$" }
      },
      "required": ["enabled"],
      "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
      "then": { "required": ["clientId"], "properties": { "clientId": { "minLength": 1 } } }
    },
    "destination": {
      "type": "object",
      "additionalProperties": true,
      "description": "Inert pass-through. Present so verify-catalog's probe values do not fail strict additionalProperties:false validation; the chart itself does not consume this field."
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "zaehlwerk-piezo-sim chart",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "image", "zaehlwerkURL", "board"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1}
      }
    },
    "zaehlwerkURL": {"type": "string", "pattern": "^https?://"},
    "board": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bestOf": {"type": "integer", "enum": [1, 3, 5, 7]},
        "pace": {"type": "string", "pattern": "^[0-9]+(ms|s|m)$"},
        "ambiguous": {"type": "string", "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$"},
        "resend": {"type": "string", "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$"},
        "undo": {"type": "string", "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$"},
        "seed": {"type": "string", "pattern": "^-?[0-9]+$"}
      }
    },
    "resources": {"type": "object"}
  }
}

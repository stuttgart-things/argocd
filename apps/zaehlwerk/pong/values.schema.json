{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "zaehlwerk-pong chart",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "image",
    "zaehlwerkURL"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "zaehlwerkURL": {
      "type": "string",
      "pattern": "^https?://"
    },
    "bestOf": {
      "type": "integer",
      "enum": [
        1,
        3,
        5,
        7
      ]
    },
    "botSkill": {
      "type": "string",
      "pattern": "^(leicht|mittel|schwer)(,(leicht|mittel|schwer))?$"
    },
    "attractAfter": {
      "type": "string",
      "pattern": "^([0-9]+(ms|s|m|h))?$",
      "description": "PONG_ATTRACT_AFTER. Empty = attract mode off (the variable is left out)."
    },
    "league": {
      "type": "object",
      "additionalProperties": false,
      "description": "League mode (zaehlwerk v0.31.0+): real, reported matches between schmetterpause players. Sandbox only; needs zaehlwerk's MATCHES_TOKEN in the zaehlwerk-panel Secret.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "operator": {
          "type": "string",
          "minLength": 1
        },
        "playerSkill": {
          "type": "string",
          "minLength": 1
        },
        "pause": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h)$"
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "namespace",
            "sectionName"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "namespace": {
              "type": "string",
              "minLength": 1
            },
            "sectionName": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "caBundle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "configMap": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "destination": {
      "type": "object",
      "additionalProperties": true,
      "description": "Inert pass-through. Present so verify-catalog's probe values do not fail strict additionalProperties:false validation; the chart itself does not consume this field."
    }
  }
}

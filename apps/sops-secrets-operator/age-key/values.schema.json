{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sops-secrets-operator age-key chart",
  "type": "object",
  "additionalProperties": false,
  "required": ["secretName", "dataKey", "namespaces", "secretStoreRef", "remoteKey", "property"],
  "properties": {
    "secretName":      { "type": "string", "minLength": 1 },
    "dataKey":         { "type": "string", "minLength": 1 },
    "namespaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "secretStoreRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["SecretStore", "ClusterSecretStore"] },
        "name": { "type": "string", "minLength": 1 }
      },
      "required": ["kind", "name"]
    },
    "remoteKey":       { "type": "string", "minLength": 1, "not": { "pattern": "/data/" }, "description": "Entry name under the store's mount, not a KV path." },
    "property":        { "type": "string", "minLength": 1 },
    "refreshInterval": { "type": "string", "minLength": 1 },
    "destination": {
      "type": "object",
      "additionalProperties": true,
      "description": "Inert pass-through. Present so verify-catalog's probe values do not fail strict additionalProperties:false validation; the chart itself does not consume this field."
    }
  }
}

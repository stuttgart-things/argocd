{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "homerun2 app-of-apps chart",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "destination"
  ],
  "properties": {
    "applicationName": {
      "type": "string",
      "minLength": 1
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repoURL": {
          "type": "string",
          "format": "uri"
        },
        "targetRevision": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "repoURL",
        "targetRevision"
      ]
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "description": "Argo destination for all rendered child Applications. Provide `server` (cluster URL) or `name` (registered cluster name) \u2014 at least one required. If both are set (e.g. when overriding the default `server` with a `name`), the template prefers `name`; this is intentional so consumers can switch to a name without having to null out the chart's default server.",
      "properties": {
        "server": {
          "type": "string",
          "format": "uri"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "namespace"
      ],
      "anyOf": [
        {
          "required": [
            "server"
          ]
        },
        {
          "required": [
            "name"
          ]
        }
      ]
    },
    "syncPolicy": {
      "type": "object",
      "additionalProperties": true
    },
    "trustBundleConfigMap": {
      "type": "string",
      "minLength": 1
    },
    "k8sPitcherProfileConfigMap": {
      "type": "string",
      "minLength": 1
    },
    "redisPassword": {
      "type": "string"
    },
    "authToken": {
      "type": "string"
    },
    "redisStack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "chartVersion": {
          "type": "string",
          "minLength": 1
        },
        "serviceType": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "existingSecretPasswordKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "storageClass": {
              "type": "string",
              "minLength": 1
            },
            "size": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[0-9]+(Ki|Mi|Gi|Ti|Pi|Ei)?$"
            }
          },
          "required": [
            "enabled"
          ]
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "registry": {
              "type": "string",
              "minLength": 1
            },
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "registry",
            "repository",
            "tag"
          ]
        },
        "sentinel": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "registry": {
              "type": "string",
              "minLength": 1
            },
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "registry",
            "repository",
            "tag"
          ]
        }
      },
      "required": [
        "enabled"
      ]
    },
    "omniPitcher": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "inlineHttpRoute": {
          "type": "boolean"
        },
        "routesContent": {
          "type": "string",
          "description": "omni-pitcher stream routing file as a YAML string: streams allowlist, default_stream, ordered routes. Empty keeps the single-stream path."
        },
        "routesPath": {
          "type": "string",
          "description": "Mount path for the routing file; ROUTES_CONFIG points at <routesPath>/routes.yaml."
        }
      },
      "required": [
        "enabled"
      ]
    },
    "coreCatcher": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "kustomizeVersion": {
          "type": "string",
          "minLength": 1
        },
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "inlineHttpRoute": {
          "type": "boolean"
        },
        "redisStream": {
          "type": "string"
        },
        "basePath": {
          "type": "string",
          "pattern": "^(/[a-z0-9][a-z0-9-]*)?$",
          "description": "BASE_PATH: one path segment, e.g. /led behind homerun2-portal; empty serves at the root"
        }
      },
      "required": [
        "enabled"
      ]
    },
    "scout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "inlineHttpRoute": {
          "type": "boolean"
        },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Render the ScoutProfile CR through apps/homerun2/scout-profile."
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Must match SCOUT_PROFILE_NAME of the scout base (default)."
            },
            "spec": {
              "type": "object",
              "description": "ScoutProfile spec (homerun2-scout docs/scout-profile.md). alerting.pitcherToken is rejected: the token comes from homerun2-omni-pitcher-token.",
              "properties": {
                "alerting": {
                  "type": "object",
                  "not": {
                    "required": [
                      "pitcherToken"
                    ]
                  }
                }
              }
            },
            "content": {
              "type": "string",
              "description": "The ScoutProfile spec as a YAML string (e.g. from a cluster annotation). Set, it replaces `spec` and renders the ScoutProfile even with enabled: false. Must parse to a map. With aiPitcher on, the ai-* systems are added to a digest.excludeSystems it lists. Never put alerting.pitcherToken in it: the token comes from homerun2-omni-pitcher-token."
            }
          }
        },
        "retentionTTL": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))*$",
          "description": "SCOUT_RETENTION_TTL env (Go duration, e.g. 360h). Empty sets nothing, except with aiPitcher's weekly mode on, which gets 360h (15 days). A ScoutProfile's retention.ttl wins."
        }
      },
      "required": [
        "enabled"
      ]
    },
    "k8sPitcher": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "inlineProfile": {
          "type": "boolean"
        },
        "profileContent": {
          "type": "string",
          "description": "K8sPitcherProfile document as a YAML string. Empty keeps the out-of-band contract; set it and the chart materializes k8sPitcherProfileConfigMap itself."
        },
        "extraRbacRules": {
          "type": "array",
          "description": "Extra rules appended to the base's ClusterRole homerun2-k8s-pitcher (which grants get/list/watch on pods, nodes, events, deployments, replicasets and get on secrets), for a profile that informs on other resources.",
          "items": {
            "type": "object",
            "required": [
              "apiGroups",
              "resources",
              "verbs"
            ],
            "properties": {
              "apiGroups": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "resources": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "resourceNames": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "verbs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "required": [
        "enabled"
      ]
    },
    "lightCatcher": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "inlineHttpRoute": {
          "type": "boolean"
        },
        "basePath": {
          "type": "string",
          "pattern": "^(/[a-z0-9][a-z0-9-]*)?$",
          "description": "BASE_PATH: one path segment, e.g. /led behind homerun2-portal; empty serves at the root"
        }
      },
      "required": [
        "enabled"
      ]
    },
    "wledMock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "hostname": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "enabled"
      ]
    },
    "configViewer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "inlineHttpRoute": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ]
    },
    "demoPitcher": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "inlineHttpRoute": {
          "type": "boolean"
        },
        "omniPitcherUrl": {
          "type": "string"
        },
        "basePath": {
          "type": "string",
          "pattern": "^(/[a-z0-9][a-z0-9-]*)?$",
          "description": "BASE_PATH: one path segment, e.g. /led behind homerun2-portal; empty serves at the root"
        }
      },
      "required": [
        "enabled"
      ]
    },
    "ledCatcher": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "inlineHttpRoute": {
          "type": "boolean"
        },
        "basePath": {
          "type": "string",
          "pattern": "^(/[a-z0-9][a-z0-9-]*)?$",
          "description": "BASE_PATH: one path segment, e.g. /led behind homerun2-portal; empty serves at the root"
        }
      },
      "required": [
        "enabled"
      ]
    },
    "portal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "services": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*(\\|[^=,]+)?=https?://[^,/]+/?$"
          }
        }
      },
      "required": [
        "enabled"
      ]
    },
    "notificationCatcher": {
      "type": "object",
      "additionalProperties": false,
      "description": "Redis Streams consumer that fans messages out to MS Teams / generic webhooks \u2014 the other half of the Alertmanager/Grafana chain. No Service and no route. Needs the notify ConfigMap (notifyConfig, or out-of-band) and a Secret carrying the webhook URL (teamsWebhookUrl, secrets.teamsWebhookVaultSecretName, or out-of-band).",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "redisStream": {
          "type": "string",
          "minLength": 1
        },
        "redisStreams": {
          "type": "string",
          "description": "Comma-separated streams (REDIS_STREAMS), all consumed by the one Deployment; takes precedence over redisStream. Empty = not rendered, redisStream alone."
        },
        "dryRun": {
          "type": "boolean"
        },
        "notifyConfigMap": {
          "type": "string",
          "minLength": 1
        },
        "notifyConfig": {
          "type": "string",
          "description": "The notify config (config.yaml) as a YAML string. Set, the chart materializes notifyConfigMap from it through the apps/homerun2/notification-catcher-notify sub-Application (sync-wave -10) and rolls the Pod when it changes. Empty = the ConfigMap is provisioned out-of-band. `${TEAMS_WEBHOOK_URL}` placeholders are passed through verbatim; the catcher expands them."
        },
        "teamsWebhookUrl": {
          "type": "string",
          "description": "Empty deletes the Secret the base ships, so an out-of-band/ESO-managed one of the same name takes over. Inline literals only via ArgoCD Vault Plugin / SOPS."
        }
      },
      "required": [
        "enabled"
      ]
    },
    "gitPitcher": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "inlineHttpRoute": {
          "type": "boolean"
        },
        "inlineWatchConfig": {
          "type": "boolean",
          "description": "Keep the watch profile shipped in the kustomize OCI. False deletes it and mounts gitPitcherWatchConfigMap instead."
        }
      },
      "required": [
        "enabled"
      ]
    },
    "aiPitcher": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "timeZone": {
          "type": "string",
          "minLength": 1
        },
        "suspend": {
          "type": "boolean",
          "description": "Suspends every mode's CronJob."
        },
        "modes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "morning",
            "evening",
            "weekAhead",
            "weekly"
          ],
          "description": "One CronJob per mode (ai-pitcher v0.4+); a disabled mode's CronJob is not deployed. Each pitches as its own system (ai-digest, ai-evening, ai-week-ahead, ai-weekly; morning and weekly also ai-ticker).",
          "properties": {
            "morning": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "schedule"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "schedule": {
                  "type": "string",
                  "minLength": 1,
                  "description": "CronJob homerun2-ai-pitcher (base: 45 7 * * 1-5)."
                }
              }
            },
            "evening": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "schedule"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "schedule": {
                  "type": "string",
                  "minLength": 1,
                  "description": "CronJob homerun2-ai-pitcher-evening (base: 45 18 * * 1-5)."
                }
              }
            },
            "weekAhead": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "schedule"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "schedule": {
                  "type": "string",
                  "minLength": 1,
                  "description": "CronJob homerun2-ai-pitcher-week-ahead (base: 50 7 * * 1)."
                }
              }
            },
            "weekly": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "schedule"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "schedule": {
                  "type": "string",
                  "minLength": 1,
                  "description": "CronJob homerun2-ai-pitcher-weekly (base: 0 15 * * 5). Reads scout's weekly window (scout v0.12+) and needs 15 days of scout retention."
                }
              }
            }
          }
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "OpenRouter model id or a comma-separated list (tried in groups of 3)."
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "retries": {
          "type": "integer",
          "minimum": 0
        },
        "schedulePitcherURL": {
          "type": "string",
          "description": "URL of a schedule-pitcher NOT installed by this chart; ignored while schedulePitcher is enabled (then the in-cluster Service is used). Empty skips the open findings."
        },
        "schedulePitcherTokenSecret": {
          "type": "string",
          "minLength": 1,
          "description": "Secret (key auth-token) holding that schedule-pitcher's API token; ignored while schedulePitcher is enabled."
        }
      },
      "required": [
        "enabled"
      ],
      "description": "homerun2-ai-pitcher: CronJobs (morning, evening, week-ahead, weekly) summarising scout's digest and the schedule-pitcher's open findings via OpenRouter. Needs scout and omni-pitcher; the OpenRouter key is optional (secrets.openrouterVaultSecretName)."
    },
    "schedulePitcher": {
      "type": "object",
      "additionalProperties": false,
      "description": "homerun2-schedule-pitcher, central instance: expiry checks, reminders and findings from agents, delivered through the in-cluster omni-pitcher; web UI + JSON API behind a route. Token from the per-cluster Vault property schedulePitcherAuthToken (secrets.enabled).",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "inlineHttpRoute": {
          "type": "boolean"
        },
        "profileConfigMap": {
          "type": "string",
          "minLength": 1,
          "description": "ConfigMap (key profile.yaml) the chart creates through apps/homerun2/schedule-pitcher-profile and the Deployment mounts."
        },
        "profileContent": {
          "type": "string",
          "description": "SchedulePitcherProfile as a YAML string. Empty = a minimal profile without checks (in-cluster omni-pitcher, grafana format, Europe/Berlin). A change rolls the Pod."
        },
        "secretAccess": {
          "type": "array",
          "description": "get on exactly these Secrets, one Role + RoleBinding per namespace, for the profile's tokenFrom.secretKeyRef checks.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "namespace",
              "secrets"
            ],
            "properties": {
              "namespace": {
                "type": "string",
                "minLength": 1
              },
              "secrets": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      },
      "required": [
        "enabled"
      ]
    },
    "soundCatcher": {
      "type": "object",
      "additionalProperties": false,
      "description": "homerun2-sound-catcher, browser sink only (no speaker in a Pod): announcements on the player page behind the route. Redis password and /play token (authToken) via secrets.enabled.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "redisStreams": {
          "type": "string",
          "minLength": 1,
          "description": "Comma-separated streams to announce (REDIS_STREAMS)."
        }
      },
      "required": [
        "enabled"
      ]
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "namespace": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "namespace"
          ]
        }
      },
      "required": [
        "enabled"
      ]
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional sub-Application that materialises the Secrets the workloads consume (omni-pitcher auth-token + redis password, redis-stack auth) from a ClusterSecretStore + Vault path. When `enabled: false` (default), nothing is rendered \u2014 the cluster relies on inline `redisPassword`/`authToken` literals or out-of-band-managed Secrets.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "clusterSecretStoreName": {
          "type": "string",
          "minLength": 1
        },
        "vaultSecretName": {
          "type": "string",
          "minLength": 1
        },
        "refreshInterval": {
          "type": "string",
          "pattern": "^[0-9]+(s|m|h)$"
        },
        "githubTokenVaultSecretName": {
          "type": "string",
          "description": "Entry the git-pitcher's githubToken is read from (same store). Empty = vaultSecretName. A per-cluster entry has no PAT; it lives shared, e.g. `_git-pat`."
        },
        "teamsWebhookVaultSecretName": {
          "type": "string",
          "description": "Shared entry (same store) the notification-catcher's Teams webhook URL is read from, property `teamsWebhookUrl`, e.g. `_teams-webhook`. Set (and notificationCatcher enabled, teamsWebhookUrl empty), an ExternalSecret materializes `homerun2-notification-catcher-secrets` with key TEAMS_WEBHOOK_URL. Empty = no ExternalSecret; the Secret comes from the literal or out-of-band."
        },
        "openrouterVaultSecretName": {
          "type": "string",
          "description": "Shared entry (same store) the ai-pitcher's OpenRouter key is read from, property `openrouterApiKey`, e.g. `_openrouter`. Set (and aiPitcher enabled), an ExternalSecret materializes `homerun2-ai-pitcher-openrouter` with key api-key. Empty = no ExternalSecret; the ai-pitcher then runs without AI (plain digest, \"[AI n/a]\")."
        }
      },
      "required": [
        "enabled"
      ]
    },
    "smokeTest": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional sub-Application that runs a smoke test against the deployed omni-pitcher: /health on the in-cluster Service, an unauthenticated POST /pitch that must be rejected, an authenticated fixture post, and optionally the same three through the public HTTPRoute. Rendered as an ArgoCD PostSync hook Job, so a failed assertion fails the sync. Requires the omni-pitcher auth-token Secret to exist (inline `authToken` or `secrets.enabled`).",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "podSecurityContext": {
          "type": "object",
          "additionalProperties": true,
          "description": "Pod-level securityContext. runAsUser must be numeric \u2014 curlimages/curl's USER is the name `curl_user`, which the kubelet cannot verify against runAsNonRoot."
        },
        "hook": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "deletePolicy": {
              "type": "string",
              "enum": [
                "BeforeHookCreation",
                "HookSucceeded",
                "HookFailed"
              ]
            }
          }
        },
        "job": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "backoffLimit": {
              "type": "integer",
              "minimum": 0
            },
            "ttlSecondsAfterFinished": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "activeDeadlineSeconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "healthCheck": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "attempts": {
              "type": "integer",
              "minimum": 1
            },
            "intervalSeconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "unauthenticated": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "expectStatus": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            }
          }
        },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "description": "Second pass through the public HTTPRoute. The hostname comes from omniPitcher.hostname, not from here.",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "caConfigMap": {
              "type": "string"
            },
            "caKey": {
              "type": "string"
            },
            "connectToGateway": {
              "type": "boolean",
              "description": "Derive curl --connect-to from httpRoute.gateway (cilium-gateway-<name>.<ns>.svc.cluster.local), because a Cilium L2-announced LoadBalancer VIP is not reachable from Pods on the same cluster."
            },
            "connectTo": {
              "type": "string",
              "description": "Explicit --connect-to host; wins over connectToGateway."
            },
            "insecure": {
              "type": "boolean"
            }
          }
        },
        "extraProbes": {
          "type": "array",
          "description": "Extra components to liveness-probe. core-catcher and scout are added automatically when enabled; this list covers anything else.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "service": {
                "type": "string",
                "minLength": 1
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "path": {
                "type": "string"
              },
              "hostname": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "service",
              "port"
            ]
          }
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "type": "string"
              },
              "author": {
                "type": "string"
              },
              "system": {
                "type": "string"
              },
              "tags": {
                "type": "string"
              }
            },
            "required": [
              "title",
              "message"
            ]
          }
        }
      },
      "required": [
        "enabled"
      ]
    },
    "gitPitcherWatchConfigMap": {
      "type": "string",
      "minLength": 1,
      "description": "Out-of-band ConfigMap holding git-pitcher's watch-profile.yaml; used only when gitPitcher.inlineWatchConfig is false. Not created by this chart."
    },
    "omniPitcherRoutesConfigMap": {
      "type": "string",
      "description": "Name of the ConfigMap holding omni-pitcher's routing file. Only used when omniPitcher.routesContent is set."
    },
    "cascadingDelete": {
      "type": "boolean",
      "description": "Put a resources-finalizer on every rendered child Application, so deleting the parent prunes the workloads. True (the default) for preview environments; the platforms/ AppSets set it false, because for a long-lived install an opt-out should stop managing the stack rather than delete it, and a prune against a deregistered cluster hangs the children in Terminating (argocd#324)."
    },
    "reloader": {
      "type": "boolean",
      "description": "Annotate every component Deployment and the redis-stack StatefulSet with reloader.stakater.com/auto, so a changed Secret or ConfigMap rolls them. No-op without the Reloader controller."
    }
  }
}

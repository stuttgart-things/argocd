{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "externalsecrets values",
  "type": "object",
  "required": [
    "namespace",
    "clusterSecretStoreName",
    "secrets"
  ],
  "additionalProperties": false,
  "properties": {
    "destination": {
      "type": "object",
      "additionalProperties": true,
      "description": "Inert pass-through so verify-catalog's probe values validate; not consumed."
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "clusterSecretStoreName": {
      "type": "string",
      "description": "ClusterSecretStore each ExternalSecret references. Must exist on the workload cluster."
    },
    "refreshInterval": {
      "type": "string",
      "pattern": "^[0-9]+(s|m|h)$",
      "default": "1h"
    },
    "secrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "secretName",
          "data"
        ],
        "additionalProperties": false,
        "properties": {
          "secretName": {
            "type": "string",
            "minLength": 1
          },
          "data": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "secretKey",
                "vaultSecretName",
                "property"
              ],
              "additionalProperties": false,
              "properties": {
                "secretKey": {
                  "type": "string",
                  "minLength": 1
                },
                "vaultSecretName": {
                  "type": "string",
                  "minLength": 1
                },
                "property": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "template": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Optional target.template.data (ESO engine v2): Secret key -> Go template over the fetched secretKeys. Without it the fetched keys are the Secret."
          }
        }
      }
    }
  }
}

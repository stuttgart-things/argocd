{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "kargo-admin from Vault",
  "type": "object",
  "additionalProperties": false,
  "required": ["namespace", "clusterSecretStoreName", "vaultSecretName", "secretName"],
  "properties": {
    "destination": {
      "type": "object",
      "additionalProperties": true,
      "description": "Inert pass-through. Present so verify-catalog's probe values do not fail strict additionalProperties:false validation; the chart itself does not consume this field."
    },
    "namespace":              { "type": "string", "minLength": 1 },
    "clusterSecretStoreName": { "type": "string", "minLength": 1 },
    "vaultSecretName":        { "type": "string" },
    "secretName":             { "type": "string", "minLength": 1 }
  }
}

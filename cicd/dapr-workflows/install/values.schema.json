{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dapr-workflows-install values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalog",
    "project",
    "destination",
    "secrets",
    "redis",
    "templateExecution",
    "clusterBuildWatch",
    "syncPolicy"
  ],
  "properties": {
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repoURL",
        "targetRevision"
      ],
      "properties": {
        "repoURL": {
          "type": "string"
        },
        "targetRevision": {
          "type": "string"
        }
      }
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "server"
      ],
      "properties": {
        "server": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "applicationName": {
      "type": "string"
    },
    "cascadingDelete": {
      "type": "boolean"
    },
    "syncPolicy": {
      "type": "object",
      "additionalProperties": true
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clusterSecretStoreName",
        "vaultSecretName"
      ],
      "properties": {
        "clusterSecretStoreName": {
          "type": "string",
          "description": "ClusterSecretStore on the workload cluster; required as soon as a worker is enabled"
        },
        "vaultSecretName": {
          "type": "string",
          "minLength": 1,
          "description": "own entry (redisPassword)"
        },
        "refreshInterval": {
          "type": "string",
          "pattern": "^[0-9]+(s|m|h)$"
        },
        "shared": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "githubToken",
            "backstageToken",
            "homerunAuthToken",
            "machineryToken"
          ],
          "properties": {
            "githubToken": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "vaultSecretName"
              ],
              "properties": {
                "clusterSecretStoreName": {
                  "type": "string",
                  "description": "\"\" = the own store"
                },
                "vaultSecretName": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "backstageToken": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "vaultSecretName"
              ],
              "properties": {
                "clusterSecretStoreName": {
                  "type": "string",
                  "description": "\"\" = the own store"
                },
                "vaultSecretName": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "homerunAuthToken": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "vaultSecretName"
              ],
              "properties": {
                "clusterSecretStoreName": {
                  "type": "string",
                  "description": "\"\" = the own store"
                },
                "vaultSecretName": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "machineryToken": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "vaultSecretName"
              ],
              "properties": {
                "clusterSecretStoreName": {
                  "type": "string",
                  "description": "\"\" = the own store"
                },
                "vaultSecretName": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "redis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "namespace",
        "chartVersion"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "chartVersion": {
          "type": "string",
          "minLength": 1
        },
        "storageClass": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "string",
          "pattern": "^[0-9]+(Mi|Gi|Ti)$"
        }
      }
    },
    "templateExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "namespace",
        "kustomize",
        "image",
        "trigger"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "kustomize": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repoURL",
            "targetRevision"
          ],
          "properties": {
            "repoURL": {
              "type": "string",
              "minLength": 1,
              "description": "OCI kustomize artifact; oci:// is prepended when missing"
            },
            "targetRevision": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "tag"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "backstageURL": {
          "type": "string",
          "pattern": "^https?://"
        },
        "caConfigMap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "key"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "trigger": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "targetRevision"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "targetRevision": {
              "type": "string",
              "minLength": 1,
              "description": "<worker tag>-trigger"
            }
          }
        },
        "runs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repoURL",
            "targetRevision",
            "path"
          ],
          "properties": {
            "repoURL": {
              "type": "string",
              "minLength": 1
            },
            "targetRevision": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "description": "directory of BackstageTemplateRun files; empty = no runs Application"
            }
          }
        }
      }
    },
    "clusterBuildWatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "namespace",
        "kustomize",
        "image",
        "trigger"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "kustomize": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repoURL",
            "targetRevision"
          ],
          "properties": {
            "repoURL": {
              "type": "string",
              "minLength": 1,
              "description": "OCI kustomize artifact; oci:// is prepended when missing"
            },
            "targetRevision": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "tag"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "homerunPitchURL": {
          "type": "string",
          "description": "omni-pitcher /pitch URL; empty disables the homerun sink"
        },
        "machineryAuth": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "trigger": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "targetRevision"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "targetRevision": {
              "type": "string",
              "minLength": 1,
              "description": "<worker tag>-trigger"
            }
          }
        },
        "discovery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "server",
            "gitops",
            "exclude",
            "lookback",
            "argoServer"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "server": {
              "type": "string",
              "description": "machinery gRPC host:port holding the ClusterStacks; required when enabled"
            },
            "gitops": {
              "type": "string",
              "description": "<namespace>/<name> of the Flux Kustomization of the gitops phase; empty = no gitops phase"
            },
            "exclude": {
              "type": "string",
              "description": "comma-separated <namespace>/<name> globs never watched"
            },
            "lookback": {
              "type": "string",
              "pattern": "^[0-9]+(s|m|h)$"
            },
            "argoServer": {
              "type": "string",
              "description": "machinery on the Argo CD cluster; empty = no Argo checkpoint"
            }
          }
        }
      }
    }
  }
}

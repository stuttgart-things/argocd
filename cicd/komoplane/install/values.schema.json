{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "komoplane install app-of-apps chart",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "catalog", "destination", "chartVersion"],
  "properties": {
    "applicationName": {
      "type": "string",
      "minLength": 1,
      "description": "Optional explicit name for the rendered Application. Defaults to a per-cluster derived name."
    },
    "project": { "type": "string", "minLength": 1 },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repoURL", "targetRevision"],
      "properties": {
        "repoURL": { "type": "string", "minLength": 1 },
        "targetRevision": { "type": "string", "minLength": 1 }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "description": "Argo destination. Provide `server` or `name`; `name` wins when both are set. Must be a cluster running Crossplane.",
      "properties": {
        "server": { "type": "string", "format": "uri" },
        "name": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string", "minLength": 1 }
      },
      "required": ["namespace"],
      "anyOf": [{ "required": ["server"] }, { "required": ["name"] }]
    },
    "chartVersion": { "type": "string", "minLength": 1 },
    "debug": { "type": "boolean" },
    "mrCacheTTL": { "type": "string", "minLength": 1 },
    "mrdCacheTTL": { "type": "string", "minLength": 1 },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "resources": { "type": "object" },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": ["boolean", "string"],
          "enum": [true, false, "true", "false"],
          "description": "Boolean, or the strings an ApplicationSet template produces."
        },
        "hostname": { "type": "string" },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "namespace": { "type": "string", "minLength": 1 },
            "sectionName": { "type": "string" }
          }
        }
      }
    },
    "extraValues": { "type": "object" },
    "syncPolicy": { "type": "object" }
  }
}

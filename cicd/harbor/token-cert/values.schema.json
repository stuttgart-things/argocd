{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "harbor-token-cert values",
  "type": "object",
  "additionalProperties": false,
  "required": ["namespace", "secretName"],
  "properties": {
    "destination": {"type": "object", "additionalProperties": true, "description": "Inert pass-through for the catalog probe; not consumed."},
    "namespace": {"type": "string", "minLength": 1},
    "secretName": {"type": "string", "minLength": 1},
    "duration": {"type": "string", "pattern": "^[0-9]+h$"},
    "renewBefore": {"type": "string", "pattern": "^[0-9]+h$"}
  }
}

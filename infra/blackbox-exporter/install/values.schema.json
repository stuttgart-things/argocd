{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "blackbox-exporter app-of-apps chart",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "destination", "chartVersion"],
  "properties": {
    "applicationName": {
      "type": "string",
      "description": "Optional explicit name for the rendered ArgoCD Application. Defaults to a per-cluster derived name to avoid collisions when deployed to multiple clusters."
    },
    "project": { "type": "string", "minLength": 1 },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "server":    { "type": "string", "format": "uri" },
        "namespace": { "type": "string", "minLength": 1 }
      },
      "required": ["server", "namespace"]
    },
    "chartVersion": { "type": "string", "minLength": 1 },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modules": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "object" }
        }
      },
      "required": ["modules"]
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name":                      { "type": "string", "minLength": 1 },
          "url":                       { "type": "string", "format": "uri" },
          "hostname":                  { "type": "string", "minLength": 1 },
          "module":                    { "type": "string", "minLength": 1 },
          "interval":                  { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
          "scrapeTimeout":             { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
          "labels":                    { "type": "object" },
          "additionalMetricsRelabels": { "type": "object" },
          "additionalRelabeling":      { "type": "array" }
        },
        "required": ["name", "url"]
      }
    },
    "alerts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "alert":       { "type": "string", "minLength": 1 },
              "expr":        { "type": "string", "minLength": 1 },
              "for":         { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
              "labels":      { "type": "object" },
              "annotations": { "type": "object" }
            },
            "required": ["alert", "expr"]
          }
        }
      },
      "required": ["enabled"]
    },
    "extraValues": { "type": "object" },
    "syncPolicy": { "type": "object" }
  }
}

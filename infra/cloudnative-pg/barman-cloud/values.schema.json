{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cloudnative-pg barman-cloud plugin app-of-apps chart",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "destination", "chartVersion"],
  "properties": {
    "applicationName": {
      "type": "string",
      "description": "Optional explicit name for the rendered ArgoCD Application. Defaults to a per-cluster derived name to avoid collisions when deployed to multiple clusters."
    },
    "project": { "type": "string", "minLength": 1 },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "server":    { "type": "string", "format": "uri" },
        "name":      { "type": "string", "minLength": 1 },
        "namespace": { "type": "string", "minLength": 1, "description": "Must be the CloudNativePG operator's namespace." }
      },
      "required": ["namespace"]
    },
    "chartVersion": { "type": "string", "minLength": 1 },
    "extraValues": { "type": "object" },
    "syncPolicy": { "type": "object" }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "kube-prometheus-stack ExternalSecrets",
  "type": "object",
  "additionalProperties": false,
  "required": ["namespace", "secretStore", "remoteKey", "grafana", "webhook"],
  "properties": {
    "namespace": { "type": "string", "minLength": 1 },
    "secretStore": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["ClusterSecretStore", "SecretStore"] },
        "name": { "type": "string", "minLength": 1 }
      },
      "required": ["kind", "name"]
    },
    "remoteKey": { "type": "string", "minLength": 1, "not": { "pattern": "/data/" } },
    "grafana": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled":          { "type": "boolean" },
        "targetName":       { "type": "string", "minLength": 1 },
        "userProperty":     { "type": "string", "minLength": 1 },
        "passwordProperty": { "type": "string", "minLength": 1 }
      },
      "required": ["enabled", "targetName", "userProperty", "passwordProperty"]
    },
    "webhook": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled":       { "type": "boolean" },
        "targetName":    { "type": "string", "minLength": 1 },
        "tokenProperty": { "type": "string", "minLength": 1 }
      },
      "required": ["enabled", "targetName", "tokenProperty"]
    }
  }
}

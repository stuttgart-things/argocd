{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "prometheus-pve-exporter install app-of-apps chart",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "catalog", "destination", "image", "target", "secretName", "externalSecrets"],
  "definitions": {
    "flag": {
      "type": ["boolean", "string"],
      "enum": [true, false, "true", "false"],
      "description": "Boolean, or the strings \"true\"/\"false\" an ApplicationSet template produces."
    }
  },
  "properties": {
    "applicationName": { "type": "string", "minLength": 1 },
    "project": { "type": "string", "minLength": 1 },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repoURL", "targetRevision"],
      "properties": {
        "repoURL": { "type": "string", "minLength": 1 },
        "targetRevision": { "type": "string", "minLength": 1 }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "description": "Argo destination. Provide `server` or `name`; `name` wins when both are set. `namespace` must be kube-prometheus-stack's.",
      "properties": {
        "server": { "type": "string", "format": "uri" },
        "name": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string", "minLength": 1 }
      },
      "required": ["namespace"],
      "anyOf": [{ "required": ["server"] }, { "required": ["name"] }]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 }
      }
    },
    "target": { "type": "string", "minLength": 1, "description": "Proxmox host scraped via ?target=." },
    "verifySSL": { "$ref": "#/definitions/flag" },
    "secretName": { "type": "string", "minLength": 1 },
    "externalSecrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "$ref": "#/definitions/flag" },
        "refreshInterval": { "type": "string", "minLength": 1 },
        "secretStore": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "enum": ["ClusterSecretStore", "SecretStore"] },
            "name": { "type": "string" }
          }
        },
        "remoteKey": { "type": "string", "minLength": 1 },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "user": { "type": "string", "minLength": 1 },
            "tokenName": { "type": "string", "minLength": 1 },
            "tokenValue": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "scrape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interval": { "type": "string", "minLength": 1 },
        "scrapeTimeout": { "type": "string", "minLength": 1 }
      }
    },
    "resources": { "type": "object" },
    "reloader": { "$ref": "#/definitions/flag" },
    "dashboard": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "$ref": "#/definitions/flag" } }
    },
    "syncPolicy": { "type": "object" }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "oauth2-proxy ExternalSecrets",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "namespaces",
    "targetName",
    "secretStore",
    "remoteKey",
    "clientIdProperty",
    "clientSecretProperty",
    "cookieSecretProperty"
  ],
  "properties": {
    "destination": {
      "type": "object",
      "additionalProperties": true,
      "description": "Inert pass-through. Present so verify-catalog's probe values do not fail strict additionalProperties:false validation; the chart itself does not consume this field."
    },
    "namespaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "targetName": {
      "type": "string",
      "minLength": 1
    },
    "secretStore": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "ClusterSecretStore",
            "SecretStore"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "name"
      ]
    },
    "remoteKey": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "/data/"
      }
    },
    "clientIdProperty": {
      "type": "string",
      "minLength": 1
    },
    "clientSecretProperty": {
      "type": "string",
      "minLength": 1
    },
    "cookieSecretProperty": {
      "type": "string",
      "minLength": 1
    }
  }
}
